# Stuff for celery
CELERY_BROKER_URL=amqp://ano:ano@localhost:5672/ano
CELERY_RESULT_BACKEND=amqp://ano:ano@localhost:5672/ano


# Stuff for Postgres (Railway credentials) — copy real values from the
# Railway dashboard/CLI for your own environment. Never commit real values here.
PG_DATABASE=railway
PG_USER=postgres
PG_PASSWORD=your-postgres-password
PG_HOST=postgres.railway.internal
PG_PORT=5432

# Full connection string (from Railway dashboard)
DATABASE_URL=postgresql://postgres:your-postgres-password@postgres.railway.internal:5432/railway

# Other environment variables
DATABASE_PUBLIC_URL=postgresql://postgres:your-postgres-password@postgres.railway.internal:5432/railway
DISCORD_CLIENT_ID=1447272377896669236
DISCORD_CLIENT_SECRET=your-discord-client-secret
# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: https://affairsandorder.com/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord bot service (Railway service name: bot) — NOT an HTTP server; no PORT needed
DISCORD_BOT_TOKEN=
BOT_API_BASE_URL=https://affairsandorder.com
# Optional: override derived auth (otherwise bot API uses SECRET_KEY-derived secret)
BOT_API_SECRET=
# Do not use DISCORD_BOT_URL — Phase 1 bot calls the web API, not bot.railway.internal
ENVIRONMENT=PROD
PYTHONPATH=/app
REDIS_PUBLIC_URL=redis://default:your-redis-password@redis.railway.internal:6379
REDIS_URL=redis://default:your-redis-password@redis.railway.internal:6379
SECRET_KEY=generate-a-long-random-hex-string-do-not-reuse-across-environments

SENDGRID_API_KEY="X"

# Stripe (Gems store, FEATURE_STORE — off by default). Test-mode keys from
# your Stripe sandbox; STRIPE_WEBHOOK_SECRET comes from `stripe listen`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Patreon (monthly Gems bonus, FEATURE_PATREON_GEMS — off by default; also
# used by the /patreon Discord command regardless of the flag). Creator's
# access token + campaign ID from your Patreon creator dashboard.
PATREON_ACCESS_TOKEN=
PATREON_CAMPAIGN_ID=
